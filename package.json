{
  "name": "@hyperttp/cache",
  "version": "1.1.0",
  "description": "High-performance LRU caching plugin for Hyperttp client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "hyperttp"
  ],
  "author": "dirold2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-cache.git"
  },
  "dependencies": {
    "@hyperttp/types": "^0.1.1",
    "lru-cache": "^11.5.1"
  },
  "peerDependencies": {
    "@hyperttp/core": "^1.2.0"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.0.16",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "latest",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "latest"
  },
  "scripts": {
    "build": "tsc && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "publish": "d-publish",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write .",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  }
}
